<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 🌟 앱 전체 테마: SmartBulk는 시스템 설정과 무관하게 고정 다크 + 포레스트그린 브랜드 톤 -->
    <style name="Theme.SmartBulk" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_muted</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/on_accent</item>

        <!-- Surface / Background -->
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/stroke_subtle</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>

        <!-- 상태바 / 내비게이션바: 다크 배경 + 밝은 아이콘 -->
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <item name="toolbarStyle">@style/SmartBulk.Toolbar</item>
        <item name="materialButtonStyle">@style/SmartBulk.Button</item>
        <item name="textInputStyle">@style/SmartBulk.TextInputLayout</item>
        <item name="materialAlertDialogTheme">@style/SmartBulk.AlertDialog</item>
    </style>

    <!-- 로그인/회원가입도 동일한 브랜드 톤 사용 (배경 이미지 위라 별도 오버라이드 여지만 남겨둠) -->
    <style name="Theme.SmartBulk.Login" parent="Theme.SmartBulk" />

    <!-- 🧭 공통 툴바 스타일 -->
    <style name="SmartBulk.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text_primary</item>
        <item name="android:background">@color/bg_base</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- 🟢 기본(포인트 컬러) 버튼 -->
    <style name="SmartBulk.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ⬜ 테두리만 있는 보조 버튼 (닫기 등) -->
    <style name="SmartBulk.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/stroke_subtle</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 텍스트 전용(투명) 버튼 -->
    <style name="SmartBulk.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 입력창 (회원가입 등 TextInputLayout) -->
    <style name="SmartBulk.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/accent</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- 카드 -->
    <style name="SmartBulk.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 다이얼로그: 기본 AlertDialog는 앱 다크 테마를 안 타서 흰 배경으로 튀는 문제가 있어
         MaterialAlertDialogBuilder + 이 스타일을 명시적으로 써야 함 -->
    <style name="SmartBulk.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="materialAlertDialogTitleTextStyle">@style/SmartBulk.AlertDialog.Title</item>
        <item name="shapeAppearanceOverlay">@style/SmartBulk.AlertDialog.Shape</item>
    </style>

    <style name="SmartBulk.AlertDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="SmartBulk.AlertDialog.Shape" parent="">
        <item name="cornerSize">18dp</item>
    </style>

    <!-- 달력 그리드 위 요일 헤더 (7열, 달력 칸과 같은 비율로 배치) -->
    <style name="SmartBulk.WeekdayHeader" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>
