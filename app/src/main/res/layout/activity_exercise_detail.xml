<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 📌 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="100dp"> <!-- ✅ 버튼 공간만큼 여백 추가 -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- 운동 이름 -->
            <TextView
                android:id="@+id/tvExerciseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="운동 이름"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 운동 설명 -->
            <TextView
                android:id="@+id/tvExerciseDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="운동에 대한 자세한 설명이 여기에 표시됩니다."
                android:textSize="16sp"
                android:textColor="#555555"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvExerciseName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 세트 -->
            <TextView
                android:id="@+id/tvLabelSets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="세트"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvExerciseDescription"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvExerciseSets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4세트"
                android:textSize="18sp"
                android:layout_marginStart="8dp"
                app:layout_constraintBaseline_toBaselineOf="@id/tvLabelSets"
                app:layout_constraintStart_toEndOf="@id/tvLabelSets" />

            <!-- 횟수 -->
            <TextView
                android:id="@+id/tvLabelReps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="횟수"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvLabelSets"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvExerciseReps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12회"
                android:textSize="18sp"
                android:layout_marginStart="8dp"
                app:layout_constraintBaseline_toBaselineOf="@id/tvLabelReps"
                app:layout_constraintStart_toEndOf="@id/tvLabelReps" />

            <!-- 상세 설명 -->
            <TextView
                android:id="@+id/tvExerciseDetailDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="상세 설명"
                android:textAppearance="?attr/textAppearanceBody1"
                app:layout_constraintTop_toBottomOf="@id/tvExerciseReps"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 운동 예시 GIF -->
            <ImageView
                android:id="@+id/ivExerciseGif"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:scaleType="fitCenter"
                app:layout_constraintTop_toBottomOf="@id/tvExerciseDetailDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 📌 자세 피드백 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPoseFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="자세 피드백 받기"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/ivExerciseGif"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- 📌 닫기 버튼 (항상 화면 하단 고정) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="닫기"
        android:layout_gravity="bottom"
        android:layout_margin="16dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
