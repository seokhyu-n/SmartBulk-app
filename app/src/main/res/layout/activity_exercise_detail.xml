<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <!-- 📌 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="100dp"> <!-- ✅ 버튼 공간만큼 여백 추가 -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- 운동 이름 -->
            <TextView
                android:id="@+id/tvExerciseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="운동 이름"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 운동 설명 -->
            <TextView
                android:id="@+id/tvExerciseDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="운동에 대한 자세한 설명이 여기에 표시됩니다."
                android:textSize="15sp"
                android:textColor="@color/accent"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/tvExerciseName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 세트 / 횟수 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSetsReps"
                style="@style/SmartBulk.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:layout_constraintTop_toBottomOf="@id/tvExerciseDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLabelSets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="세트"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvExerciseSets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4세트"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLabelReps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="횟수"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvExerciseReps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12회"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 상세 설명 -->
            <TextView
                android:id="@+id/tvExerciseDetailDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="상세 설명"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="4dp"
                app:layout_constraintTop_toBottomOf="@id/cardSetsReps"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 운동 예시 GIF -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExerciseGif"
                style="@style/SmartBulk.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:layout_constraintTop_toBottomOf="@id/tvExerciseDetailDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivExerciseGif"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 📌 자세 피드백 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPoseFeedback"
                style="@style/SmartBulk.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="자세 피드백 받기"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/cardExerciseGif"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- 📌 닫기 버튼 (항상 화면 하단 고정) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseDetail"
        style="@style/SmartBulk.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="닫기"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:backgroundTint="@color/bg_base" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
