<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 배경색 (이미지 아래 빈 공간을 자연스럽게 채움) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_base" />

    <!-- 배경 이미지: 화면 전체를 채워서 아래쪽에 앱 기본 배경색(bg_base)이 그대로
         드러나 경계가 뚝 끊겨 보이는 문제를 없앴다. 아래쪽은 login_scrim이 자연스럽게 어둡게 처리. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/smartbulk_login_bg"
        android:scaleType="centerCrop"
        android:contentDescription="배경 이미지" />

    <!-- 다크 스크림: 사진 위에서도 텍스트 대비를 확보하고 앱 전체 톤과 통일 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/login_scrim" />

    <!-- 로그인 콘텐츠 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="bottom|center_horizontal">

            <!-- 앱 이름 로고 -->
            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SmartBulk"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI 자세 인식으로 정확하게 성장하기"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="36dp" />

            <!-- 이메일 입력 -->
            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:hint="이메일"
                android:inputType="textEmailAddress"
                android:background="@drawable/rounded_edittext_translucent"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp" />

            <!-- 비밀번호 입력 (비밀번호 보기 토글) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:hint="비밀번호"
                    android:inputType="textPassword"
                    android:background="@drawable/rounded_edittext_translucent"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:gravity="center_vertical" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_visibility_off"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="비밀번호 보기 전환" />
            </RelativeLayout>

            <!-- 자동 로그인 체크박스 -->
            <CheckBox
                android:id="@+id/cbAutoLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="자동 로그인"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent"
                android:layout_marginBottom="16dp" />

            <!-- 로그인 버튼 -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="로그인"
                android:background="@drawable/rounded_button_translucent"
                android:textColor="@color/on_accent"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp" />

            <!-- 회원가입 텍스트 -->
            <TextView
                android:id="@+id/btnRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원가입"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <!-- 비밀번호를 잊으셨나요 텍스트 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호를 잊으셨나요?"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
