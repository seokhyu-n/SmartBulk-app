<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Main Content -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            android:title="SmartBulk"
            android:titleTextColor="@android:color/white"
            app:menu="@menu/top_app_bar_menu" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <!-- 사용자 정보 카드 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="@android:color/white">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/textName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="안녕하세요, 사용자님!"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/textAge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="나이: 25세"
                            android:textSize="16sp"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/textHeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="키: 175cm"
                            android:textSize="16sp"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/textWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="몸무게: 70kg"
                            android:textSize="16sp"
                            android:textColor="@android:color/black" />

                        <TextView
                            android:id="@+id/textGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="목표: 근육 증가"
                            android:textSize="16sp"
                            android:textColor="@android:color/black" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 추천 루틴 제목 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="오늘의 추천 루틴"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp" />

                <!-- 추천 루틴 요약 (동적 텍스트) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTodayRoutine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/textTodayRoutine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏋 🔥 오늘의 추천 루틴 🔥\n

            상체 강화 트레이닝 — 30분 집중 근력 향상\n
            하체 유산소 세션 — 20분 활력 충전\n
            전신 스트레칭 — 10분 몸의 밸런스 맞추기"
                            android:textSize="16sp"
                            android:textColor="@android:color/black" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ✅ 오늘의 식단 추천 추가 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="오늘의 식단 추천"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTodayMeal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/textTodayMeal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍽 오늘의 식단 🍽\n
           • 아침: 오트밀 + 바나나 + 삶은 달걀 2개\n
           • 점심: 현미밥 + 닭가슴살 + 브로콜리\n
           • 저녁: 단백질 쉐이크 + 구운 채소\n

           균형 잡힌 식단으로 건강한 하루를 시작!"
                            android:textSize="16sp"
                            android:textColor="@android:color/black" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 운동 시작 버튼 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartWorkout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="운동 시작하기"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:layout_marginTop="12dp"
                    android:icon="@drawable/ic_baseline_fitness_center_24"
                    android:iconTint="@android:color/white"
                    app:iconPadding="8dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="@android:color/white" />

                <!-- 동기부여 문구 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="“꾸준함이 힘이다! 오늘도 화이팅!”"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="?attr/colorPrimary"
                    android:gravity="center"
                    android:layout_marginTop="24dp" />

                <!-- 최근 운동 -->
                <TextView
                    android:id="@+id/textLastWorkout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="지난 운동: 상체 운동 30분 (어제)"
                    android:textSize="14sp"
                    android:textColor="@android:color/darker_gray"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        app:menu="@menu/drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
