<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 이름, 이메일, 운동 목표 -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이름: --"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이메일: --"
            android:textSize="16sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="운동 목표: --"
            android:textSize="16sp"
            android:paddingBottom="12dp" />

        <!-- 회원가입일, 활동 레벨 -->
        <TextView
            android:id="@+id/tvSignupDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="회원가입일: --"
            android:textSize="14sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvActivityLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="활동 레벨: --"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <!-- 최근 운동 완료 날짜와 횟수 -->
        <TextView
            android:id="@+id/tvRecentWorkoutDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="최근 운동 완료 날짜: --"
            android:textSize="14sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvWorkoutCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="운동 횟수: --"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <!-- 누적 운동 시간, 운동 루틴 개수 -->
        <TextView
            android:id="@+id/tvTotalWorkoutTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="누적 운동 시간: --"
            android:textSize="14sp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvRoutineCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="운동 루틴 개수: --"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <!-- 나의 운동 스타일 태그 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="운동 스타일:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/layoutTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:layout_marginBottom="20dp"
            app:flexWrap="wrap"
            app:justifyContent="flex_start" />

        <!-- 개인정보 설정 버튼 -->
        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="내 정보 변경"
            android:padding="12dp"
            android:layout_marginTop="8dp" />

        <!-- 앱 문의 / 버그 신고, FAQ -->
        <TextView
            android:id="@+id/tvAppInquiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 문의 / 버그 신고하기"
            android:textColor="#666666"
            android:textSize="14sp"
            android:paddingTop="24dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvFAQ"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="자주 묻는 질문 (FAQ)"
            android:textColor="#666666"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
