<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 목표 체중 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목표 체중 (kg)"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etGoalWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="예: 70.5"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/rounded_edittext"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginTop="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveWeight"
            style="@style/SmartBulk.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="저장"
            android:layout_marginTop="10dp" />

        <!-- 운동 목표 변경 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="운동 목표 변경"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="28dp" />

        <Spinner
            android:id="@+id/spinnerExerciseGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_edittext"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeGoal"
            style="@style/SmartBulk.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="변경"
            android:layout_marginTop="10dp" />

        <!-- 운동 빈도 설정 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="운동 빈도 설정 (주 몇 회)"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="28dp" />

        <Spinner
            android:id="@+id/spinnerWorkoutFrequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_edittext"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveFrequency"
            style="@style/SmartBulk.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="저장"
            android:layout_marginTop="10dp" />

        <!-- 앱 버전 정보 -->
        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 버전: 1.0.0"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="36dp" />

        <!-- 카피라이트 -->
        <TextView
            android:id="@+id/tvCopyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="© 2026 SmartBulk Inc."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- 개발사 연락처 -->
        <TextView
            android:id="@+id/tvContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="문의: gongbuhaja06@naver.com"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- 피드백 보내기 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="피드백 보내기"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
