<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 목표 체중 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목표 체중 (kg)"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etGoalWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="예: 70.5"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnSaveWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="저장"
            android:layout_marginTop="8dp"
            style="@style/SmartBulk.Button" />

        <!-- 운동 목표 변경 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="운동 목표 변경"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

        <Spinner
            android:id="@+id/spinnerExerciseGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnChangeGoal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="변경"
            android:layout_marginTop="8dp"
            style="@style/SmartBulk.Button" />

        <!-- 운동 빈도 설정 추가 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="운동 빈도 설정 (주 몇 회)"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

        <Spinner
            android:id="@+id/spinnerWorkoutFrequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSaveFrequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="저장"
            android:layout_marginTop="8dp"
            style="@style/SmartBulk.Button" />

        <!-- 앱 버전 정보 -->
        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 버전: 1.0.0"
            android:layout_marginTop="32dp" />

        <!-- 카피라이트 -->
        <TextView
            android:id="@+id/tvCopyright"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="© 2025 SmartBulk Inc."
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- 개발사 연락처 -->
        <TextView
            android:id="@+id/tvContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="문의: gongbuhaja06@naver.com"
            android:textColor="@color/purple_700"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <!-- 피드백 보내기 (글자만 보여주기) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="피드백 보내기"
            android:textColor="@color/purple_700"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
